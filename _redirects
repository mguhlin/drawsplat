# Cloudflare Pages redirects
# Vanity short URLs for CipherSplat. The canonical app lives at
# /solutions/CipherSplat/ so it keeps the strict per-route security
# headers defined in _headers. These 301s let people type a short path
# and land on the real one.
/ciphersplat        /solutions/CipherSplat/          301
/ciphersplat/       /solutions/CipherSplat/          301
/ciphersplat/*      /solutions/CipherSplat/:splat    301
/CipherSplat        /solutions/CipherSplat/          301
/CipherSplat/       /solutions/CipherSplat/          301
/CipherSplat/*      /solutions/CipherSplat/:splat    301

# VideoSplat vanity URL. Keep a matching /videosplat/index.html fallback for
# static hosts such as GitHub Pages that do not process this file.
/videosplat         /solutions/videosplat/           301
/videosplat/        /solutions/videosplat/           301
/videosplat/*       /solutions/videosplat/:splat     301

# GIFsplat renamed from Animated GIF Maker; preserve old bookmarks and assets.
/solutions/animated-gif                 /solutions/gifsplat/         301
/solutions/animated-gif/                /solutions/gifsplat/         301
/solutions/animated-gif/index.html      /solutions/gifsplat/         301
/solutions/animated-gif/*               /solutions/gifsplat/:splat   301

# SplatWorks ecosystem short links, on both production domains.
/layoutsplat  /splatworks/layoutsplat/  301
/layoutsplat/  /splatworks/layoutsplat/  301
/layoutsplat/*  /splatworks/layoutsplat/:splat  301
/writesplat  /splatworks/writesplat/  301
/writesplat/  /splatworks/writesplat/  301
/writesplat/*  /splatworks/writesplat/:splat  301
/showsplat  /splatworks/showsplat/  301
/showsplat/  /splatworks/showsplat/  301
/showsplat/*  /splatworks/showsplat/:splat  301
/gridsplat  /splatworks/gridsplat/  301
/gridsplat/  /splatworks/gridsplat/  301
/gridsplat/*  /splatworks/gridsplat/:splat  301
/listsplat  /splatworks/listsplat/  301
/listsplat/  /splatworks/listsplat/  301
/listsplat/*  /splatworks/listsplat/:splat  301
