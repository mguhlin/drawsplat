{
  "name": "writesplat",
  "version": "0.1.0",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "cp index.vite.html index.html && vite --host 127.0.0.1",
    "build": "cp index.vite.html index.html && tsc -b && vite build && rm -rf assets && mkdir -p assets && cp dist/assets/* ./assets/ && cp dist/index.html ./index.html",
    "build:singlefile": "npm run build && node scripts/build-singlefile.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.9"
  }
}
