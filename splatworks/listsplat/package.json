{
  "name": "listsplat",
  "version": "0.1.0",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "cp index.vite.html index.html && vite --host 127.0.0.1",
    "build": "cp index.vite.html index.html && tsc -b && vite build && rm -rf assets && mkdir -p assets && cp dist/assets/* ./assets/ && cp dist/index.html ./index.html",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
